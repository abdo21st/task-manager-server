# رابط قاعدة بيانات PostgreSQL في Coolify أو السيرفر الخاص بك
DATABASE_URL="postgresql://postgres:password@localhost:5432/task_manager?schema=public"

# معرّف عميل الويب من Google Cloud Console (Web Application Client ID)
GOOGLE_WEB_CLIENT_ID="YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"

# مفتاح سري طويل وعشوائي لتوقيع جلسات JWT (لا يقل عن 32 حرفاً)
JWT_SECRET="replace-with-a-strong-random-secret-key-at-least-32-chars"
